# Dataverse
DATAVERSE_BASE_URL="https://demo.dataverse.org"
DATAVERSE_API_TOKEN="tu_token_aqui"
DATAVERSE_PARENT_ALIAS="root"
# Punto de contacto por defecto (GeoNetwork no exporta el mail del contacto).
DATAVERSE_DEFAULT_CONTACT_NAME="Área de Sensores Remotos"
DATAVERSE_DEFAULT_CONTACT_EMAIL="sensores.remotos@unr.edu.ar"
DATAVERSE_DEFAULT_SUBJECT='["Other"]'

# GeoNetwork
GEONETWORK_BASE_URL="http://localhost:8080/geonetwork"
GEONETWORK_USER="admin"
GEONETWORK_PASSWORD="tu_password_aqui"
GEONETWORK_VERIFY_CERTS=true
GEONETWORK_TIMEOUT=30

# Geoserver
GEOSERVER_BASE_URL="http://localhost:8080/geoserver"
GEOSERVER_USER="admin"
GEOSERVER_PASSWORD="tu_password_aqui"
GEOSERVER_VERIFY_CERTS=true
GEOSERVER_TIMEOUT=60
# Formato de descarga por tipo de capa. Cambiar format y extension juntos.
GEOSERVER_WCS_FORMAT="image/tiff"
GEOSERVER_WCS_EXTENSION=".tif"
GEOSERVER_WFS_FORMAT="application/json"
GEOSERVER_WFS_EXTENSION=".geojson"
# Literales que devuelve el REST de GeoServer para el tipo de capa.
GEOSERVER_LAYER_TYPE_RASTER="RASTER"
GEOSERVER_LAYER_TYPE_VECTOR="VECTOR"
